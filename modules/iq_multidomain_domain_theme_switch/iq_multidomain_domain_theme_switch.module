<?php

/**
 * @file
 * Contains iq_multidomain_theme_switch.module.
 */

use Drupal\domain_config\Config\DomainConfigCollectionUtils;
use Drupal\iq_multidomain_domain_theme_switch\Plugin\views\row\Pattern;

/**
 * Implements hook_ui_patterns_info_alter().
 *
 * Remove patterns detected by default pattern deriver.
 */
function iq_multidomain_domain_theme_switch_ui_patterns_info_alter(array &$definitions) {
  foreach ($definitions as $key => $patternDefinition) {
    if (str_starts_with($key, 'yaml')) {
      unset($definitions[$key]);
    }
  }
}

/**
 * Implements hook_views_plugins_row_alter().
 */
function iq_multidomain_domain_theme_switch_views_plugins_row_alter(array &$plugins) {
  // Change the used class of a plugin.
  $plugins['ui_patterns']['class'] = Pattern::class;
}

/**
 * Implements hook_preprocess_pattern_views_row().
 */
function iq_multidomain_domain_theme_switch_preprocess_pattern_views_row(array &$variables) {

  $fields = [];
  /** @var \Drupal\views\ViewExecutable $view */
  $view = $variables['view'];
  /** @var \Drupal\ui_patterns_views\Plugin\views\row\Pattern $row_plugin */
  $row_plugin = $view->rowPlugin;
  /** @var \Drupal\views\ResultRow $row */
  $row = $variables['row'];

  $options = $variables['options'];
  $pattern_prefix = FALSE;
  $pattern_ids = array_keys(\Drupal::service('plugin.manager.ui_patterns')->getDefinitions());

  // Get the default site theme - patterns from this theme are NOT prefixed.
  $default_theme = \Drupal::config('system.theme')->get('default');

  // Try to get the theme from domain config override.
  $domain = \Drupal::service('domain.negotiator')->getActiveDomain();
  $domain_theme = NULL;
  if ($domain) {
    // First try Domain 3.x format (collection-based config).
    /** @var \Drupal\Core\Config\StorageInterface $configStorage */
    $configStorage = \Drupal::service('config.storage');
    $domain_collection = $configStorage->createCollection(
      DomainConfigCollectionUtils::createDomainConfigCollectionName($domain->id())
    );
    $theme_config = $domain_collection->read('system.theme');
    if (!empty($theme_config['default'])) {
      $domain_theme = $theme_config['default'];
    }

    // Fall back to legacy Domain 2.x format.
    if (!$domain_theme) {
      $legacy_config = \Drupal::config('domain.config.' . $domain->id() . '.system.theme');
      if (!empty($legacy_config->get('default'))) {
        $domain_theme = $legacy_config->get('default');
      }
    }
  }

  // Only use prefix if domain theme is different from default theme.
  // Default theme patterns are not prefixed.
  $active_theme = $domain_theme ?: $default_theme;
  if ($active_theme && $active_theme !== $default_theme) {
    $pattern_prefix = $active_theme . '_';
  }

  foreach ($options['pattern_mapping'] as $mapping) {
    $field_name = $mapping['source'];
    $field = $view->field[$field_name];
    $field_output = $view->style_plugin->getField($row->index, $field_name);
    if ($row_plugin->isFieldVisible($field, $field_output)) {
      $destination = $row_plugin->getMappingDestination('views_row', $field_name, $options);
      $fields[$destination][] = $field_output;
    }
  }

  $variables['pattern'] = [];
  if (empty($view->live_preview) && !empty($fields)) {
    // Determine the pattern ID to use.
    $base_pattern = $options['pattern'];
    $pattern_id = $base_pattern;

    // Use prefixed version only for secondary themes.
    if ($pattern_prefix && in_array($pattern_prefix . $base_pattern, $pattern_ids)) {
      $pattern_id = $pattern_prefix . $base_pattern;
    }
    // For default theme or fallback, use unprefixed pattern.
    elseif (!in_array($base_pattern, $pattern_ids)) {
      // Pattern doesn't exist - log warning.
      \Drupal::logger('iq_multidomain_domain_theme_switch')->warning(
        'Pattern @pattern not found.',
        [
          '@pattern' => $base_pattern,
        ]
      );
    }

    $variables['pattern'] = [
      '#type' => 'pattern',
      '#id' => $pattern_id,
      '#fields' => $fields,
      '#multiple_sources' => TRUE,
      '#variant' => $options['pattern_variant'] ?? '',
    ];

    // Allow default context values to not override those exposed elsewhere.
    $variables['pattern']['#context']['type'] = 'views_row';
    $variables['pattern']['#context']['view_name'] = $view->storage->id();
    $variables['pattern']['#context']['display'] = $view->current_display;
    $variables['pattern']['#context']['view'] = $view;
    $variables['pattern']['#context']['row'] = $row;
  }
}
